# Midnight network config — set these in Vercel Project Settings → Environment Variables
# Local dev: copy to .env.local (values below are the preview-network defaults,
# the app falls back to them when vars are absent).

NEXT_PUBLIC_MIDNIGHT_NETWORK=preview
NEXT_PUBLIC_MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/api/v3/graphql
NEXT_PUBLIC_CONTRACT_ADDRESS=f3f925b30c5ea1ac029f651f6f3738494a5031f1d9fe4d829ab99ab0cff4c871
NEXT_PUBLIC_MIDNIGHT_EXPLORER_URL=https://explorer.preview.midnight.network

# Write flows (wallet txs) — not consumed by the read path yet, keep for later wiring:
NEXT_PUBLIC_MIDNIGHT_RPC_URL=https://rpc.preview.midnight.network
NEXT_PUBLIC_MIDNIGHT_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v3/graphql/ws
NEXT_PUBLIC_MIDNIGHT_PROOF_SERVER_URL=https://proof-server.preview.midnight.network
NEXT_PUBLIC_MIDNIGHT_FAUCET_URL=https://faucet.preview.midnight.network
