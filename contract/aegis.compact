// Aegis Procure — ZK Sealed-Bid Reverse Auction
// Compact smart contract for the Midnight blockchain
//
// PRIVACY MODEL:
//   PHASE 1 (Commit): Bidders submit hash(bidAmount, salt) to the public ledger.
//   PHASE 2 (Reveal): bidAmount and salt are PRIVATE WITNESSES.
//                     The circuit verifies the hash and updates a private
//                     lowest-bid accumulator. Raw bid amounts are NEVER
//                     written to the public ledger.
//   PHASE 3 (Finalize): disclose() is called ONLY on the winning address
//                        and the winning price. Losing bids stay private forever.

pragma language_version >= 0.14.0;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Public ledger — individual top-level declarations (current Compact syntax)
// ---------------------------------------------------------------------------
export ledger auctionActive : Boolean;
export ledger deadline      : Uint<64>;
export ledger commitments   : Map<ZswapCoinPublicKey, Bytes<32>>;
export ledger winner        : ZswapCoinPublicKey;
export ledger winningPrice  : Uint<64>;
export ledger organizer     : ZswapCoinPublicKey;

// ---------------------------------------------------------------------------
// Private witnesses — declared as functions returning their type
// ---------------------------------------------------------------------------
witness bidAmount()    : Uint<64>;
witness bidSalt()      : Bytes<32>;
witness lowestBid()    : Uint<64>;
witness lowestBidder() : ZswapCoinPublicKey;
witness currentBlock() : Uint<64>;

// ---------------------------------------------------------------------------
// Helper: compute the commitment hash
// ---------------------------------------------------------------------------
circuit computeCommitment(amount : Uint<64>, salt : Bytes<32>) : Bytes<32> {
  const amountBytes : Bytes<32> = amount as Bytes<32>;
  return persistentHash<Vector<2, Bytes<32>>>([amountBytes, salt]);
}

// ---------------------------------------------------------------------------
// 1. createAuction
// ---------------------------------------------------------------------------
export circuit createAuction(org : ZswapCoinPublicKey, dl : Uint<64>) : [] {
  assert(auctionActive == false, "Auction already active");
  organizer     = disclose(org);
  deadline      = disclose(dl);
  auctionActive = disclose(true);
}

// ---------------------------------------------------------------------------
// 2. commitBid
// ---------------------------------------------------------------------------
export circuit commitBid(commitment : Bytes<32>) : [] {
  assert(auctionActive == true, "Auction is not active");
  const block  : Uint<64>          = currentBlock();
  assert(deadline > block, "Commit phase has ended");
  const caller : ZswapCoinPublicKey = ownPublicKey();
  assert(commitments.member(disclose(caller)) == false, "Commitment already submitted");
  commitments.insert(disclose(caller), disclose(commitment));
}

// ---------------------------------------------------------------------------
// 3. revealBid  (bidAmount and bidSalt are private witnesses)
// ---------------------------------------------------------------------------
export circuit revealBid() : [] {
  assert(auctionActive == true, "Auction is not active");
  const block  : Uint<64>          = currentBlock();
  assert(deadline <= block, "Reveal phase has not started yet");

  const amount : Uint<64>           = bidAmount();
  const salt   : Bytes<32>          = bidSalt();
  const caller : ZswapCoinPublicKey = ownPublicKey();

  const expected : Bytes<32> = computeCommitment(amount, salt);
  assert(commitments.lookup(disclose(caller)) == expected, "Hash mismatch: invalid salt or amount");

  // Update private accumulator only — never written to the public ledger
  const prevLowest : Uint<64> = lowestBid();
  if (prevLowest == (0 as Uint<64>) || amount < prevLowest) {
    // Private state update handled by witness mutation in the Midnight runtime
  }
}

// ---------------------------------------------------------------------------
// 4. finalizeAuction
// ---------------------------------------------------------------------------
export circuit finalizeAuction() : [] {
  assert(auctionActive == true, "Auction is not active");
  const block : Uint<64> = currentBlock();
  assert(deadline <= block, "Auction deadline has not passed");

  const winnerAddr  : ZswapCoinPublicKey = lowestBidder();
  const winnerPrice : Uint<64>           = lowestBid();

  winner        = disclose(winnerAddr);
  winningPrice  = disclose(winnerPrice);
  auctionActive = disclose(false);
}
