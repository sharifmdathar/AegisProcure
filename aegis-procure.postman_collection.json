                "type": "text/javascript",
                "exec": [
                  "pm.test(\"finalizeAuction correctly discloses the minimum bid and winner\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"winner\");",
                  "    pm.expect(json).to.have.property(\"winningPrice\");",
                  "    pm.expect(json.winner).to.not.be.empty;",
                  "    pm.expect(json.winningPrice).to.be.a(\"number\");",
                  "    // Ensure losing bids are NOT disclosed",
                  "    pm.expect(json).to.not.have.property(\"allBids\");",
