        {
          "name": "createAuction",
          "id": "11111111-aaaa-bbbb-cccc-dddddddddddd",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizer\": \"{{organizerKey}}\",\n  \"deadline\": \"{{auctionDeadline}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/contract/createAuction",
              "host": ["{{baseUrl}}"],
              "path": ["contract", "createAuction"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"createAuction sets correct deadline\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"auctionActive\", true);",
                  "    pm.expect(json).to.have.property(\"deadline\");",
                  "    pm.expect(json.deadline).to.eql(pm.environment.get(\"auctionDeadline\"));",
                  "});"
                ]
              }
            }
          ]
